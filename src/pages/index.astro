---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import PlanTable from '../components/PlanTable.astro';
import PlanRecommender from '../components/PlanRecommender.astro';
import FaqExplorer from '../components/FaqExplorer.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import {
  whatsappUrl,
  heroBadges,
  pillars,
  coverage,
} from '../data/site';
import { personalPlans } from '../data/plans';

const facts = [
  { value: '20+', label: 'Anos de experiência' },
  { value: '15 mil', label: 'Clientes ativos' },
  { value: '6 cidades', label: 'Atendidas direto' },
  { value: '+20 distritos', label: 'Também atendidos' },
];

const faqs = [
  {
    category: 'Suporte',
    question: 'Como proceder em casos de problema com a conexão?',
    answer:
      'Oferecemos Suporte Técnico Online gratuito, disponível todos os dias da semana das 8h às 17h, sábados das 8h às 12h. Não atendemos aos domingos e feriados.',
  },
  {
    category: 'Financeiro',
    question: 'Quais as formas de pagamento de mensalidades?',
    answer:
      'Os pagamentos podem ser feitos através de boleto bancário, cartão de crédito e débito em conta.',
  },
  {
    category: 'Planos',
    question:
      'Minha internet vai ter velocidade reduzida quando atingir o limite do pacote/plano?',
    answer:
      'Não. Nossos serviços não funcionam como um pacote de dados. Oferecemos uma conexão estável e com uso ilimitado, onde a velocidade vai ser constante 24 horas por dia, 7 dias por semana e sem limite de download/upload.',
  },
  {
    category: 'Suporte',
    question: 'O que posso fazer se minha internet não está funcionando?',
    answer:
      'Se ocorrer lentidão, ou alguma outra dificuldade relacionada à conexão, desligue o equipamento da energia elétrica por cerca de 2 minutos. Se o problema persistir, entre em contato com o suporte técnico. Estamos disponíveis com profissionais capacitados para auxiliá-lo.',
  },
  {
    category: 'Rede',
    question: 'Existe fibra óptica em todas as ruas?',
    answer:
      'Não. Porém, nossa rede de fibra óptica está em plena expansão. Caso tenha interesse em saber se temos cobertura na sua rua, fale com nossa equipe comercial pelo WhatsApp.',
  },
  {
    category: 'Financeiro',
    question: 'Não recebi a fatura desse mês, como faço para pagá-la?',
    answer:
      'A 2ª via da fatura está disponível na Área do Cliente. Você também pode solicitar por e-mail ou pelas redes sociais. Não esqueça de manter seu cadastro sempre atualizado.',
  },
];
---

<Layout title="RZnet - Internet Fibra Óptica em Curvelo e Região">
  <section class="hero" id="inicio" aria-label="Destaque">
    <div class="hero-bg" aria-hidden="true">
      <span class="hero-glow"></span>
      <span class="hero-dots"></span>
      <span class="hero-word display">FIBRA</span>
    </div>

    <div class="pad-x relative z-10 py-14 pb-16 lg:py-24 lg:pb-28">
      <div class="grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:gap-14">
        <div>
          <p class="hero-eyebrow rise" style="--d:.05s">
            <span class="hero-dot"></span>
            Fibra óptica · Curvelo e região
          </p>

          <h1 class="display hero-title mt-6 text-ink rise" style="--d:.14s">
            Internet rápida,<br /><span class="hero-accent">como deve ser!</span>
          </h1>

          <p class="lead mt-7 max-w-xl text-[15px] rise" style="--d:.26s">
            Navegue com a melhor internet de Curvelo e região. Velocidade, estabilidade e suporte
            especializado — com instalação grátis e sem fidelidade.
          </p>

          <div class="mt-8 flex flex-wrap gap-3 rise" style="--d:.36s">
            <a href="#planos" class="btn btn-red btn-sm">
              Conheça nossos planos
              <Icon name="arrowRight" class="h-4 w-4" />
            </a>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline btn-sm"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              Fale no WhatsApp
            </a>
          </div>

          <ul class="hero-chips rise" style="--d:.46s">
            <li><Icon name="check" class="h-3.5 w-3.5" strokeWidth={3} /> Instalação grátis</li>
            <li><Icon name="check" class="h-3.5 w-3.5" strokeWidth={3} /> Sem fidelidade</li>
            <li><Icon name="check" class="h-3.5 w-3.5" strokeWidth={3} /> Atendimento local</li>
          </ul>

          <ul class="hero-badges rise" style="--d:.56s">
            {
              heroBadges.map((badge) => (
                <li>
                  <span class="hero-badge-bar" />
                  <span class="mt-3.5 block text-sm font-semibold text-ink">{badge.title}</span>
                  <span class="mt-1 block text-[13px] leading-snug text-muted">
                    {badge.description}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <PlanRecommender />
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-surface">
    <div class="grid grid-cols-2 lg:grid-cols-4">
      {
        facts.map((fact, index) => (
          <div
            class:list={[
              'fact-cell',
              index > 0 && 'lg:border-l border-line',
              index % 2 === 1 && 'border-l border-line',
            ]}
            data-reveal
          >
            <span class="display fact-value block text-2xl text-ink lg:text-3xl">
              {fact.value}
            </span>
            <span class="mono mt-2 block text-ink/65">{fact.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="pad-x py-16 lg:py-24">
    <SectionHead
      num="01"
      label="Por que escolher a RZnet"
      title={'Quatro motivos<br />para <span class="text-brand">assinar</span>'}
    />

    <div class="mt-10 border-b border-line">
      {
        pillars.map((pillar, index) => (
          <article class="idx-row" data-reveal style={`--reveal-delay: ${index * 40}ms`}>
            <span class="idx-icon num">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="idx-title display text-lg text-ink sm:text-xl">{pillar.title}</h3>
              <p class="idx-desc mt-2 max-w-xl text-sm leading-relaxed text-muted">
                {pillar.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-y border-line pad-x py-16 lg:py-24" id="planos">
    <SectionHead
      num="02"
      label="Planos"
      title={'Planos que cabem no <span class="text-brand">seu bolso</span>'}
      lead="Escolha o plano ideal para sua casa. Todos com fibra óptica, Wi-Fi 6 e suporte especializado."
    />

    <div class="mt-10">
      <PlanTable
        plans={personalPlans}
        priceNote="Valores mensais. Consulte condições de instalação e disponibilidade para o seu endereço."
      />
    </div>

    <ul class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-3" data-reveal>
      {
        [
          {
            icon: 'wrench',
            title: 'Instalação grátis',
            desc: 'Instalação profissional gratuita, sem custo adicional.',
            note: 'Sem taxa de entrada',
          },
          {
            icon: 'shield',
            title: 'Sem fidelidade',
            desc: 'Contrato transparente — cancele quando quiser.',
            note: 'Zero multa',
          },
          {
            icon: 'badge',
            title: 'RZ TV + Clube',
            desc: 'Acima de 500 Mega: +220 canais e Clube de Vantagens inclusos.',
            note: 'Conteúdo incluso',
          },
        ].map((perk) => (
            <li class="perk-card group bg-white p-7">
              <span class="perk-icon">
                <Icon name={perk.icon as any} class="h-5 w-5" strokeWidth={1.8} />
              </span>
              <h3 class="display mt-5 text-base text-ink">{perk.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-muted">{perk.desc}</p>
              <span class="mono mt-4 flex items-center gap-2 text-brand">
                <span class="h-1.5 w-1.5 rounded-full bg-brand" />
                {perk.note}
              </span>
            </li>
          ))
      }
    </ul>
  </section>

  <section class="pad-x py-16 lg:py-24" id="cobertura">
    <SectionHead
      num="03"
      label="Cobertura"
      title={'Curvelo e região <span class="text-brand">conectadas</span>'}
      lead="6 cidades atendidas diretamente e mais de 20 distritos conectados pela nossa rede de fibra óptica."
    />

    <div class="mt-10 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
      <div>
        <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3" data-reveal>
          {
            coverage.cities.map((city, index) => (
              <li>
                <button
                  type="button"
                  class="city-card"
                  data-city={city.name}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <img src={city.photo} alt={`Vista de ${city.name}`} loading="lazy" decoding="async" />
                  <span class="city-card-body">
                    <span class="city-card-name">{city.name}</span>
                    <span class="mono city-card-cta">Atendida</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>

        <p class="mono mt-10 text-ink/65">Distritos atendidos</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            coverage.districts.map((district) => (
              <li class="district-pill">{district}</li>
            ))
          }
        </ul>
      </div>

      <div class="lg:sticky lg:top-[104px] lg:self-start">
        <div class="map-frame">
          <iframe
            id="coverage-map"
            src="https://www.google.com/maps?q=Curvelo,+MG,+Brasil&z=11&hl=pt-BR&output=embed"
            width="100%"
            height="100%"
            style="border:0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa de Cobertura RZnet"
          ></iframe>
        </div>

        <div class="mt-5 border border-line bg-surface p-5">
          <p class="mono text-ink/65">Disponibilidade</p>
          <p class="mt-2 text-sm text-muted">
            Confirme a cobertura e os horários de instalação para o seu endereço pelo WhatsApp.
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-red btn-sm mt-4 w-full"
          >
            <Icon name="whatsapp" class="h-4 w-4" />
            Confirmar endereço
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-surface pad-x py-16 lg:py-24" id="empresa">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <div class="flex items-center gap-3.5">
          <span class="num">04</span>
          <span class="mono text-brand">Sobre nós</span>
          <span class="h-px w-16 bg-line sm:w-24"></span>
        </div>

        <h2 class="display sec-title mt-5 text-ink">
          Mais de <span class="text-brand">20 anos</span> conectando pessoas
        </h2>

        <p class="lead mt-5 max-w-xl text-[15px]">
          Estabelecida no mercado há mais de 20 anos, a <strong class="font-semibold text-ink">RZnet
          Fibra</strong> está presente em 6 cidades e mais de 20 distritos da região, com mais de 15 mil
          clientes. A qualidade dos serviços oferecidos é o foco principal da empresa.
        </p>

        <ul class="mt-7 flex flex-wrap gap-3">
          {
            ['Fibra óptica premium', 'Suporte todos os dias', 'Planos sem limite'].map((pill) => (
              <li class="mono flex items-center gap-2.5 border border-line bg-white px-4 py-3 text-ink/70">
                <span class="h-1.5 w-1.5 rounded-full bg-brand" />
                {pill}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="border-t border-line">
        {
          [
            {
              title: 'Qualidade',
              description: 'Internet de alta velocidade com fibra óptica de última geração.',
            },
            {
              title: 'Compromisso',
              description: 'Dedicados a fornecer o melhor serviço para nossos clientes.',
            },
            {
              title: 'Proximidade',
              description: 'Equipe local, com atendimento personalizado perto de você.',
            },
          ].map((value, index) => (
            <article class="idx-row" data-reveal style={`--reveal-delay: ${index * 50}ms`}>
              <span class="idx-icon num">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="idx-title display text-lg text-ink sm:text-xl">{value.title}</h3>
                <p class="idx-desc mt-2 max-w-xl text-sm leading-relaxed text-muted">
                  {value.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pad-x py-16 lg:py-24" id="duvidas">
    <SectionHead
      num="05"
      label="Dúvidas frequentes"
      title={'Perguntas <span class="text-brand">frequentes</span>'}
      lead="Busque pelo que precisa ou filtre por categoria. Se a dúvida não estiver aqui, o time responde pelo WhatsApp todos os dias."
    />

    <div class="mt-10">
      <FaqExplorer items={faqs} />
    </div>
  </section>


  <CtaBand
    id="contato"
    title="Pronto para conectar?"
    text="Fale com nossos consultores e confirme a disponibilidade do plano ideal para o seu endereço."
    primaryLabel="Assine agora"
    secondaryLabel="Ligar agora"
    secondaryHref="tel:+553837296550"
    secondaryIcon="phone"
  />
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: #ffffff;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px 480px at 78% 4%, rgb(230 0 0 / 0.1), transparent 62%),
      radial-gradient(700px 420px at 6% 98%, rgb(230 0 0 / 0.06), transparent 60%);
  }

  .hero-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(23 23 26 / 0.1) 1px, transparent 1.5px);
    background-size: 26px 26px;
    -webkit-mask-image: linear-gradient(to bottom, black 30%, transparent 95%);
    mask-image: linear-gradient(to bottom, black 30%, transparent 95%);
  }

  .hero-word {
    position: absolute;
    left: -0.04em;
    bottom: -0.2em;
    font-size: clamp(7rem, 21vw, 19rem);
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 2px rgb(23 23 26 / 0.07);
    user-select: none;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brand-light);
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    background: var(--color-brand);
    box-shadow: 0 0 0 4px rgb(230 0 0 / 0.18);
  }

  .hero-accent {
    position: relative;
    display: inline-block;
    color: var(--color-brand);
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.9rem;
  }

  .hero-chips li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgb(23 23 26 / 0.16);
    background: #ffffff;
    padding: 0.5rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(23 23 26 / 0.78);
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .hero-chips li:hover {
    border-color: rgb(230 0 0 / 0.6);
    background: rgb(230 0 0 / 0.05);
  }

  .hero-chips li :global(svg) {
    color: var(--color-brand);
  }

  .hero-badges {
    display: grid;
    gap: 1px;
    margin-top: 2.5rem;
    border: 1px solid var(--color-line);
    background: var(--color-line);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .hero-badges {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hero-badges li {
    position: relative;
    background: #ffffff;
    padding: 1.25rem;
    transition: background-color 0.3s ease;
  }

  .hero-badges li:hover {
    background: var(--color-surface);
  }

  .hero-badge-bar {
    display: block;
    height: 6px;
    width: 24px;
    background: var(--color-brand);
    transition: width 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .hero-badges li:hover .hero-badge-bar {
    width: 56px;
  }

  .rise {
    animation: rise 0.85s cubic-bezier(0.22, 0.61, 0.36, 1) backwards;
    animation-delay: var(--d, 0s);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .perk-card {
    position: relative;
    transition:
      background-color 0.3s ease,
      transform 0.3s ease;
  }

  .perk-card:hover {
    background-color: var(--color-surface);
  }

  .perk-icon {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line);
    background: #ffffff;
    color: var(--color-brand);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .perk-card:hover .perk-icon {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #ffffff;
  }

  .fact-cell {
    position: relative;
    padding: 1.75rem clamp(1.25rem, 3vw, 2.5rem);
    transition: background-color 0.3s ease;
  }

  .fact-cell::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .fact-cell:hover {
    background-color: #ffffff;
  }

  .fact-cell:hover::before {
    transform: scaleX(1);
  }

  .fact-value {
    transition: color 0.3s ease;
  }

  .fact-cell:hover .fact-value {
    color: var(--color-brand);
  }

  .city-card {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
    border: 1px solid var(--color-line);
    background: #ffffff;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .city-card:hover {
    border-color: rgb(230 0 0 / 0.55);
    transform: translateY(-3px);
  }

  .city-card.is-active {
    border-color: var(--color-brand);
    box-shadow: 0 14px 30px -18px rgb(230 0 0 / 0.55);
  }

  .city-card.is-active .city-card-cta {
    color: var(--color-brand);
  }

  .city-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: grayscale(35%) contrast(1.05);
    transition: filter 0.35s ease;
  }

  .city-card:hover img {
    filter: grayscale(0%) contrast(1.05);
  }

  .city-card-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
  }

  .city-card-name {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: 1rem;
    color: var(--color-ink);
  }

  .city-card-cta {
    color: var(--color-brand);
  }

  .district-pill {
    border: 1px solid var(--color-line);
    background: #ffffff;
    padding: 0.5rem 0.85rem;
    font-size: 0.85rem;
    color: rgb(23 23 26 / 0.75);
    transition:
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .district-pill:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .map-frame {
    height: 340px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  @media (min-width: 1024px) {
    .map-frame {
      height: 420px;
    }
  }
</style>

<script>
  const map = document.getElementById('coverage-map') as HTMLIFrameElement | null;
  const cityCards = Array.from(document.querySelectorAll<HTMLButtonElement>('.city-card'));

  cityCards.forEach((card) => {
    card.addEventListener('click', () => {
      const city = card.dataset.city;
      if (!city || !map) return;

      cityCards.forEach((other) => {
        other.classList.toggle('is-active', other === card);
        other.setAttribute('aria-pressed', String(other === card));
      });

      map.src = `https://www.google.com/maps?q=${encodeURIComponent(`${city}, MG, Brasil`)}&z=11&hl=pt-BR&output=embed`;
      map.title = `Mapa de Cobertura RZnet — ${city}`;
    });
  });
</script>
