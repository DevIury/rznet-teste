---
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site';
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed bottom-5 right-5 z-40 flex items-center gap-3 rounded-full bg-brand py-3.5 pl-4 pr-4 text-white shadow-[0_18px_44px_-18px_rgb(255_0_0_/_0.9)] transition-all hover:bg-brand-dark hover:pr-5 sm:bottom-8 sm:right-8"
  aria-label="Assine agora pelo WhatsApp"
>
  <Icon name="whatsapp" class="h-6 w-6 shrink-0" />
  <span class="mono hidden whitespace-nowrap sm:inline">Assine no WhatsApp</span>
</a>
