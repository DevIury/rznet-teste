---
import Icon from './Icon.astro';
import { whatsappUrl, centralUrl, contact, footerLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div class="pad-x py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_0.9fr_1.1fr]">
      <div>
        <a href="/" class="inline-block" aria-label="RZnet — página inicial">
          <img src="/logo.png" alt="RZnet" class="h-16 w-auto" decoding="async" />
        </a>
        <p class="display mt-5 text-lg text-ink">
          Internet rápida,<br /><span class="text-brand">como deve ser.</span>
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-red btn-sm">
            <Icon name="whatsapp" class="h-4 w-4" />
            Assine agora
          </a>
          <a href={centralUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
            Central do Assinante
          </a>
        </div>
      </div>

      <div>
        <h2 class="mono mb-6 text-ink/65">Links rápidos</h2>
        <ul class="space-y-3.5">
          {
            footerLinks.menu.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-muted transition-colors hover:text-brand-light">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mono mb-6 text-ink/65">Contato</h2>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <Icon name="phone" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-brand" />
            <div>
              <a href={contact.phoneHref} class="font-medium text-ink transition-colors hover:text-brand">
                {contact.phone}
              </a>
              <p class="mt-0.5 text-xs text-ink/65">Seg a Sex 8h–18h · Sáb 8h–12h</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="mail" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-brand" />
            <a href={`mailto:${contact.email}`} class="text-muted transition-colors hover:text-brand-light">
              {contact.email}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="pin" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-brand" />
            <a
              href={contact.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted transition-colors hover:text-brand-light"
            >
              {contact.address}
            </a>
          </li>
        </ul>

        <h2 class="mono mb-4 mt-8 text-ink/65">Redes sociais</h2>
        <ul class="flex flex-wrap gap-2.5">
          {
            contact.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mono inline-block border border-line px-3 py-2.5 text-ink/60 transition-colors hover:border-brand hover:text-brand"
                >
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="rule mt-14"></div>

    <div class="flex flex-col items-start justify-between gap-3 pt-6 sm:flex-row sm:items-center">
      <p class="text-sm text-ink/65">
        © {year} RZnet — Todos os direitos reservados.
      </p>
      <p class="mono text-ink/65">Curvelo · MG · Brasil</p>
    </div>
  </div>
</footer>
