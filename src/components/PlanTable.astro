---
import type { Plan } from '../data/plans';
import { whatsappUrl } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  plans: Plan[];
  priceNote?: string;
}

const { plans, priceNote } = Astro.props;

const isSpeedFeature = (feature: string) => /Mbps|Gbps/.test(feature);
const featureRows = [
  ...new Set(plans.flatMap((plan) => plan.features.filter((feature) => !isSpeedFeature(feature)))),
];
const hasFeature = (plan: Plan, feature: string) => plan.features.includes(feature);
const speedLabel = (plan: Plan) => plan.speedLabel ?? `${plan.speed} Mbps`;
const isExternal = (href: string) => href.startsWith('http');
---

<div>
  <div class="overflow-x-auto" data-reveal>
    <table class="w-full min-w-[700px] border-collapse text-left">
      <caption class="sr-only">Comparação de planos, velocidades e preços</caption>
      <thead>
        <tr>
          <th scope="col" class="w-[28%] border-b border-line px-4 pb-5 align-bottom">
            <span class="mono text-ink/65">Comparativo</span>
          </th>
          {
            plans.map((plan) => (
              <th
                scope="col"
                class:list={[
                  'border-b px-4 pb-5 pt-4 text-center align-bottom',
                  plan.popular
                    ? 'border-brand/40 border-x bg-brand/5'
                    : 'border-line',
                ]}
              >
                {plan.popular && (
                  <span class="mono mb-2.5 block text-brand">Mais escolhido</span>
                )}
                <span class="display block text-2xl text-ink">{plan.name}</span>
              </th>
            ))
          }
        </tr>
      </thead>

      <tbody>
        <tr>
          <th scope="row" class="mono border-b border-line px-4 py-5 text-ink/65">
            Velocidade
          </th>
          {
            plans.map((plan) => (
              <td
                class:list={[
                  'border-b px-4 py-5 text-center',
                  plan.popular ? 'border-brand/40 border-x bg-brand/5' : 'border-line',
                ]}
              >
                <span class="display text-xl text-ink">{speedLabel(plan)}</span>
              </td>
            ))
          }
        </tr>

        <tr>
          <th scope="row" class="mono border-b border-line px-4 py-5 text-ink/65">
            A partir de
          </th>
          {
            plans.map((plan) => (
              <td
                class:list={[
                  'border-b px-4 py-5 text-center',
                  plan.popular ? 'border-brand/40 border-x bg-brand/5' : 'border-line',
                ]}
              >
                <span class="display text-2xl text-brand xl:text-3xl">R$ {plan.price}</span>
                <span class="mono mt-1.5 block text-ink/65">por mês</span>
              </td>
            ))
          }
        </tr>

        {
          featureRows.map((feature) => (
            <tr>
              <th scope="row" class="border-b border-line px-4 py-4 text-sm font-medium text-muted">
                {feature}
              </th>
              {plans.map((plan) => (
                <td
                  class:list={[
                    'border-b px-4 py-4 text-center',
                    plan.popular ? 'border-brand/40 border-x bg-brand/5' : 'border-line',
                  ]}
                >
                  {hasFeature(plan, feature) ? (
                    <Icon
                      name="check"
                      class="mx-auto h-4.5 w-4.5 text-brand"
                      strokeWidth={2.5}
                    />
                  ) : (
                    <span class="text-ink/30">—</span>
                  )}
                </td>
              ))}
            </tr>
          ))
        }

        <tr>
          <td class="px-4 py-7"></td>
          {
            plans.map((plan) => (
              <td
                class:list={[
                  'px-4 py-7 text-center',
                  plan.popular ? 'border-x border-brand/40 bg-brand/5' : '',
                ]}
              >
                <a
                  href={whatsappUrl}
                  target={isExternal(whatsappUrl) ? '_blank' : undefined}
                  rel="noopener noreferrer"
                  class:list={['btn w-full', plan.popular ? 'btn-red' : 'btn-outline btn-sm']}
                >
                  <Icon name="whatsapp" class="h-4 w-4" />
                  Assinar {plan.name}
                </a>
              </td>
            ))
          }
        </tr>
      </tbody>
    </table>
  </div>

  <p class="mono mt-4 text-ink/65 sm:hidden">Arraste a tabela para o lado →</p>
  {
    priceNote && (
      <p class="mono mt-5 text-ink/65">{priceNote}</p>
    )
  }
</div>
